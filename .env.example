# ============================================================
# StockPilot AI — Configuration (copier vers .env et remplir)
# ============================================================

# --- App ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Registre npm pour le build Docker du frontend (miroir officiel si npmjs.org est bloqué)
# NPM_REGISTRY=https://registry.npmmirror.com

# --- Base de données applicative (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://stockpilot:stockpilot@localhost:5432/stockpilot
# Alternative locale rapide (sans Docker) :
# DATABASE_URL=sqlite:///./stockpilot.db

# --- DeepSeek (narrateur LLM) ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Ingestion SAGE X3 (vues SQL Server) ---
# mode = auto (essaie X3 puis seed) | sagex3 (X3 uniquement) | seed (démo)
INGESTION_MODE=auto
X3_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Vue des VENTES
X3_SALES_SERVER=192.168.0.128\Sagex3req
X3_SALES_DATABASE=
X3_SALES_USER=sa
X3_SALES_PASSWORD=
X3_SALES_VIEW=V_VENTES

# Vue des STOCKS
X3_STOCK_SERVER=192.168.0.99\SQLX3V11
X3_STOCK_DATABASE=
X3_STOCK_USER=sa
X3_STOCK_PASSWORD=
X3_STOCK_VIEW=V_STOCKS

X3_QUERY_TIMEOUT_SECONDS=120

# --- Prévision ---
FORECAST_ENGINE=ets              # ets (Holt-Winters) | prophet
FORECAST_HORIZON_DAYS=30
MIN_HISTORY_DAYS=14

# --- Seuils métier ---
RUPTURE_COVERAGE_DAYS=15
RUPTURE_CRITICAL_COVERAGE_DAYS=7
OVERSTOCK_COVERAGE_DAYS=90
DORMANT_DAYS=60
ACCELERATION_PCT=0.40
SAFETY_STOCK_DAYS=15
DATA_MAX_AGE_DAYS=3

# --- Planification ---
BRIEFING_HOUR=8
BRIEFING_MINUTE=30
