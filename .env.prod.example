# ============================================================
# StockPilot AI — Production (copier vers .env sur le serveur)
# ============================================================

# --- App ---
DEBUG=false
CORS_ORIGINS=https://stockpilot.example.com

# --- Base de données (utilisée par docker-compose.prod.yml) ---
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=CHANGEZ_MOI
POSTGRES_DB=stockpilot
DATABASE_URL=postgresql+psycopg2://stockpilot:CHANGEZ_MOI@localhost:5432/stockpilot

# --- Redis / Worker ---
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=stockpilot

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Ingestion SAGE X3 ---
INGESTION_MODE=auto
X3_ODBC_DRIVER=ODBC Driver 18 for SQL Server
X3_SALES_SERVER=192.168.0.128\Sagex3req
X3_SALES_DATABASE=basex3
X3_SALES_USER=sa
X3_SALES_PASSWORD=CHANGEZ_MOI
X3_SALES_VIEW=VENTES_X3
X3_STOCK_SERVER=192.168.0.128\Sagex3req
X3_STOCK_DATABASE=basex3
X3_STOCK_USER=sa
X3_STOCK_PASSWORD=CHANGEZ_MOI
X3_STOCK_VIEW=STOCK_TOTAL

# --- Seuils (valeurs par défaut) ---
RUPTURE_COVERAGE_DAYS=15
RUPTURE_CRITICAL_COVERAGE_DAYS=7
OVERSTOCK_COVERAGE_DAYS=90
DORMANT_DAYS=60
ACCELERATION_PCT=0.40
SAFETY_STOCK_DAYS=15
DATA_MAX_AGE_DAYS=3

# --- Planification (briefing quotidien) ---
BRIEFING_HOUR=8
BRIEFING_MINUTE=30
